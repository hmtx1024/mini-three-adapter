{
  "name": "mini-three-adapter",
  "version": "0.1.3",
  "description": "A modern, TypeScript-first, zero-global-pollution Three.js adapter for WeChat Mini Games and Mini Programs",
  "type": "module",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmtx1024/mini-three-adapter.git"
  },
  "homepage": "https://github.com/hmtx1024/mini-three-adapter#readme",
  "bugs": {
    "url": "https://github.com/hmtx1024/mini-three-adapter/issues"
  },
  "keywords": [
    "three.js",
    "wechat",
    "minigame",
    "miniprogram",
    "adapter",
    "webgl2",
    "小游戏",
    "适配层"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "docs"
  ],
  "sideEffects": [
    "./dist/platforms/wechat-game.js",
    "./dist/platforms/wechat-miniprogram.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "import": "./dist/scope.js"
    },
    "./wechat-game": {
      "types": "./dist/platforms/wechat-game.d.ts",
      "import": "./dist/platforms/wechat-game.js"
    },
    "./wechat-miniprogram": {
      "types": "./dist/platforms/wechat-miniprogram.d.ts",
      "import": "./dist/platforms/wechat-miniprogram.js"
    },
    "./browser": {
      "types": "./dist/platforms/browser.d.ts",
      "import": "./dist/platforms/browser.js"
    },
    "./polyfills": {
      "types": "./dist/polyfills/index.d.ts",
      "import": "./dist/polyfills/index.js"
    },
    "./vite": {
      "types": "./dist/build/vite.d.ts",
      "import": "./dist/build/vite.js"
    },
    "./rollup": {
      "types": "./dist/build/rollup.d.ts",
      "import": "./dist/build/rollup.js"
    },
    "./plugin": {
      "types": "./dist/build/vite.d.ts",
      "import": "./dist/build/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "clean": "node scripts/clean.mjs",
    "prepublishOnly": "npm run clean && npm run check",
    "release:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "magic-string": "^0.30.17"
  },
  "peerDependencies": {
    "three": ">=0.163.0",
    "vite": ">=5.0.0",
    "rollup": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "rollup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
